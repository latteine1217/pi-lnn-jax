#!/bin/bash
#SBATCH --job-name=jax_bench_{EXP_ID}
#SBATCH --output=logs/jax_bench_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_bench_{EXP_ID}_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#
# What:
#   tab:inference_cost 的 per-trajectory inference 量測（encode / field query /
#   throughput / full-sequence）。該表原本無生成端，硬體欄標的 "M3 MPS" 是
#   PyTorch 的 Metal backend，本庫 JAX 沒有那條路徑。
#
# Why GPU node:
#   ckpt 由 GPU 寫出，head node 的 CPU JAX 上 orbax 推不出 sharding。載入必須在
#   GPU node 上做。量 CPU 數字用 BENCH_DEVICE=cpu：backend 仍是 cuda，腳本在
#   ckpt 載入完成後才把 params 搬到 CPU。反過來（先切成純 CPU backend 再載）
#   會讓 orbax 拿不到 sharding 而失敗——實測 job 5421。
#
# 環境變數：
#   ARTIFACTS_DIR   ckpt 所在（選填；預設取 config 的 train_kwargs.artifacts_dir）
#   ARCH            liquid（預設）；須與訓練一致
#   BENCH_GRID      全場查詢邊長（預設 128，= 論文表的 16384 pts/batch）
#   BENCH_REPEAT    重複次數（預設 20）
#   BENCH_DEVICE    gpu（預設）或 cpu —— 量測裝置，非 JAX backend
#   OUTPUT          輸出 JSON（預設 artifacts/bench/inference_{EXP_ID}_<device>.json）
#
# Protocol declaration:
#   follow_training —— benchmark 必須量在與訓練同一條時間軸上，否則 encode 的
#   序列長度 T 不同，數字不可與論文表對照。此處硬編是刻意的，不開放覆寫。
#
# 用法（lab-server head node）：
#   TMPL=scripts/slurm/bench_inference.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh benchmain5 configs/exp_main5_s42.toml

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
{ [ -d "data" ] || [ -d "$PILNJAX_DATA_ROOT/data" ]; } \
  || { echo "[ERR] 找不到 data/（cwd 或 PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT）" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；head node 先 'uv sync --python 3.12'" >&2; exit 3; }

# backend 同時掛 cuda 與 cpu，兩個需求缺一不可：cuda 必須在（ckpt 由 GPU 寫出，
# 缺了 orbax 推不出 sharding，實測 job 5421 以 ValueError 失敗），cpu 也必須在
# （BENCH_DEVICE=cpu 時要 jax.devices("cpu")，只掛 cuda 會 RuntimeError，
# 實測 job 5422）。列表首項是預設裝置。
export JAX_PLATFORMS=cuda,cpu
DEVICE="${BENCH_DEVICE:-gpu}"
export XLA_PYTHON_CLIENT_PREALLOCATE=false

ARCH="${ARCH:-liquid}"
GRID="${BENCH_GRID:-128}"
REPEAT="${BENCH_REPEAT:-20}"
OUTPUT="${OUTPUT:-artifacts/bench/inference_{EXP_ID}_${DEVICE}.json}"
ART_ARG=""
[ -n "${ARTIFACTS_DIR:-}" ] && ART_ARG="--artifacts-dir ${ARTIFACTS_DIR}"

echo "======================================================================"
echo "[JAX-BENCH-{EXP_ID}] $(date '+%F %T')  slurm_job=${SLURM_JOB_ID}  node=${SLURMD_NODENAME:-?}"
echo "  repo:      $(pwd)"
echo "  config:    {CONFIG_PATH}"
echo "  arch:      ${ARCH}"
echo "  device:    ${DEVICE}（JAX backend 恆 cuda，載入後才搬）  grid=${GRID}²  n_repeat=${REPEAT}"
echo "  protocol:  follow_training（硬編；量測必須與訓練同一時間軸）"
echo "  output:    ${OUTPUT}"
echo "======================================================================"
uv --version
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo "  (no GPU visible)"

uv run python -u scripts/bench_inference.py \
  --config "{CONFIG_PATH}" \
  --arch "${ARCH}" \
  --protocol follow_training \
  --grid "${GRID}" \
  --n-repeat "${REPEAT}" \
  --compute-device "${DEVICE}" \
  --output "${OUTPUT}" \
  ${ART_ARG}

echo "[$(date '+%F %T')] JAX-BENCH-{EXP_ID} 完成 → ${OUTPUT}"
