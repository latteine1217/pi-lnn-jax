#!/bin/bash
#SBATCH --job-name=jax_shred_{EXP_ID}
#SBATCH --output=logs/jax_shred_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_shred_{EXP_ID}_%j.err
#SBATCH --time=08:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#
# What:
#   SHRED 深度 baseline 訓練 + 多-Re 評估的 sbatch template（Phase B）。
#   由 scripts/slurm/submit_exp.sh（TMPL 覆寫）把 {EXP_ID}/{CONFIG_PATH} 替換後送 r740。
#
# Why GPU:
#   SHRED 是 LSTM + 大 decoder 的監督式訓練（不像 classical baseline），需 GPU。
#   資源配額對齊半節點（8 CPU / 1 GPU / 48G），允許與另一 job 同節點並行。
#
# Usage（lab-server head node；先 git pull + uv sync --python 3.12）:
#   TMPL=scripts/slurm/train_shred.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh shred configs/eval_multi_re_train5_crp.toml
#   # env 覆寫：HELD_OUT / GRID / WINDOW / EPOCHS / HIDDEN
#   HELD_OUT=3000,8000,30000 GRID=64 WINDOW=10 EPOCHS=300 \
#   TMPL=scripts/slurm/train_shred.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh shred configs/eval_multi_re_train5_crp.toml
#   # DRY=1 ... 先看生成 sbatch 不送出
#
# Output:
#   logs/jax_shred_{EXP_ID}_<jobid>.out；metrics: artifacts/shred/{EXP_ID}_metrics.json

set -euo pipefail

PROTOCOL="${PROTOCOL:?需指定 PROTOCOL（follow_training / fixed_grid / sensor_time_independent）——無預設是刻意的}"
PROTOCOL_REASON="${PROTOCOL_REASON:-}"
PROTO_ARGS="--protocol ${PROTOCOL}"
[ -n "$PROTOCOL_REASON" ] && PROTO_ARGS="${PROTO_ARGS} --protocol-reason ${PROTOCOL_REASON}"

cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_ROOT="${PILNJAX_ROOT:-$(pwd)}"
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
{ [ -d "$PILNJAX_ROOT/data" ] || [ -d "$PILNJAX_DATA_ROOT/data" ]; } \
  || { echo "[ERR] 找不到 data/（PILNJAX_ROOT=$PILNJAX_ROOT 或 PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT）" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；先在 head node 跑 'uv sync --python 3.12'" >&2; exit 3; }
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false

HELD_OUT="${HELD_OUT:-}"
GRID="${GRID:-64}"
WINDOW="${WINDOW:-10}"
EPOCHS="${EPOCHS:-200}"
# sensor 時間取樣必須與被比較的 PI-CON 對齊：腳本預設 stride=4 / T=50，而
# EXP-245 主線吃 stride=2（101 frames）。不對齊會讓 SHRED 只看到一半的時間
# 點，比較就不是 baseline 弱而是餵得少。
SENSOR_TIME_STRIDE="${SENSOR_TIME_STRIDE:-4}"
SENSOR_T="${SENSOR_T:-50}"
HIDDEN="${HIDDEN:-64}"
OUTPUT="${OUTPUT:-artifacts/shred/{EXP_ID}_metrics.json}"
HELD_ARG=""
[ -n "$HELD_OUT" ] && HELD_ARG="--held-out ${HELD_OUT}"

echo "======================================================================"
echo "[JAX-SHRED-{EXP_ID}] $(date '+%F %T')  slurm_job=${SLURM_JOB_ID}  node=${SLURMD_NODENAME:-?}"
echo "  config: {CONFIG_PATH}   grid=${GRID} window=${WINDOW} epochs=${EPOCHS} hidden=${HIDDEN}"
echo "  held-out: ${HELD_OUT:-<none>}   output: ${OUTPUT}"
echo "======================================================================"
nvidia-smi -L 2>/dev/null || echo "[WARN] nvidia-smi 不可用"
uv run python -c "import jax; print(f'JAX {jax.__version__} devices={jax.devices()}')"

uv run python -u scripts/train_baseline_shred.py \
  ${PROTO_ARGS} \
  --config "{CONFIG_PATH}" \
  --sensor-time-stride "${SENSOR_TIME_STRIDE}" \
  --sensor-T "${SENSOR_T}" \
  --grid "${GRID}" \
  --window "${WINDOW}" \
  --epochs "${EPOCHS}" \
  --hidden "${HIDDEN}" \
  --device cuda \
  --output "${OUTPUT}" \
  ${HELD_ARG}

echo "[$(date '+%F %T')] JAX-SHRED-{EXP_ID} 完成 → ${OUTPUT}"
