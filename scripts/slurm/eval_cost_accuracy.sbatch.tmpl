#!/bin/bash
#SBATCH --job-name=jax_costacc_{EXP_ID}
#SBATCH --output=logs/jax_costacc_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_costacc_{EXP_ID}_%j.err
#SBATCH --time=04:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#
# What:
#   Tier 0.2 的 cost-vs-accuracy 掃描（interp + gappy-POD 各模態數）的 sbatch template。
#   由 scripts/slurm/submit_exp.sh（TMPL 覆寫）把 {EXP_ID}/{CONFIG_PATH} 替換後送 slurm。
#
# Why CPU-only:
#   同 eval_baselines：POD SVD + 重建是 numpy/scipy。
#
# ⚠️ 計時量與節點負載耦合:
#   本腳本量的是重建掛鐘（`recon_s_per_field`，該圖的 x 軸）。同節點若有其他 job
#   在搶 CPU，讀數會偏高。--repeats 取最快一次以去 scheduler 噪音，但**跨 job 的
#   計時不可直接互比**；拿它做 A/B 對拍時 timing 欄位必須排除（`ab_compare` 的
#   VOLATILE_METRIC_KEYS 已內建這一條）。
#
# Usage（lab-server head node；先 uv sync --python 3.12）:
#   RE_SUBSET=10000 OUTPUT=artifacts/baseline_eval/costacc_head.json \
#   FIG=artifacts/baseline_eval/costacc_head.png \
#   TMPL=scripts/slurm/eval_cost_accuracy.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh costacchead configs/eval_multi_re_train5_crp.toml
#
# Output:
#   - slurm log：logs/jax_costacc_{EXP_ID}_<jobid>.out / .err
#   - 投影 JSON：${OUTPUT}；每個 (Re, method, modes) 另落一份 metric artifact 在同目錄

set -euo pipefail

cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_ROOT="${PILNJAX_ROOT:-$(pwd)}"
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
{ [ -d "$PILNJAX_ROOT/data" ] || [ -d "$PILNJAX_DATA_ROOT/data" ]; } \
  || { echo "[ERR] 找不到 data/（PILNJAX_ROOT=$PILNJAX_ROOT 或 PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT）" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；先在 head node 跑 'uv sync --python 3.12'" >&2; exit 3; }
export JAX_PLATFORMS=cpu

PROTOCOL="${PROTOCOL:?需指定 PROTOCOL（follow_training / fixed_grid / sensor_time_independent）；\n\
  無預設是刻意的：預設會讓人吃到錯的那一個，而錯的不會 crash、只會在別的時間解析度上算數字}"
PROTOCOL_REASON="${PROTOCOL_REASON:-}"
SENSOR_TIME_STRIDE="${SENSOR_TIME_STRIDE:-}"
PROTO_ARGS="--protocol ${PROTOCOL}"
[ -n "$PROTOCOL_REASON" ] && PROTO_ARGS="${PROTO_ARGS} --protocol-reason ${PROTOCOL_REASON}"
[ -n "$SENSOR_TIME_STRIDE" ] && PROTO_ARGS="${PROTO_ARGS} --sensor-time-stride ${SENSOR_TIME_STRIDE}"
RE_SUBSET="${RE_SUBSET:-}"
POD_MODES_LIST="${POD_MODES_LIST:-10,25,50,100,200}"
MAX_GRID="${MAX_GRID:-256}"
REPEATS="${REPEATS:-5}"
OUTPUT="${OUTPUT:-artifacts/baseline_eval/{EXP_ID}_cost_accuracy.json}"
FIG="${FIG:-artifacts/baseline_eval/{EXP_ID}_cost_accuracy.png}"

SUBSET_ARG=""
[ -n "$RE_SUBSET" ] && SUBSET_ARG="--re-subset ${RE_SUBSET}"

echo "======================================================================"
echo "[JAX-COSTACC-{EXP_ID}] $(date '+%F %T')  slurm_job=${SLURM_JOB_ID}  node=${SLURMD_NODENAME:-?}"
echo "  repo:      $(pwd)"
echo "  config:    {CONFIG_PATH}"
echo "  re-subset: ${RE_SUBSET:-<all>}   modes: ${POD_MODES_LIST}   repeats: ${REPEATS}"
echo "  output:    ${OUTPUT}"
echo "  protocol:  ${PROTOCOL}   reason: ${PROTOCOL_REASON:-<none>}"
echo "  JAX_PLATFORMS=${JAX_PLATFORMS}  cpus=${SLURM_CPUS_PER_TASK:-?}  mem=${SLURM_MEM_PER_NODE:-?}MB"
echo "======================================================================"
uv --version

uv run python -u scripts/cost_accuracy.py \
  --config "{CONFIG_PATH}" \
  --pod-modes-list "${POD_MODES_LIST}" \
  --max-grid "${MAX_GRID}" \
  --repeats "${REPEATS}" \
  --output "${OUTPUT}" \
  --fig "${FIG}" \
  ${PROTO_ARGS} \
  ${SUBSET_ARG}

echo "[$(date '+%F %T')] JAX-COSTACC-{EXP_ID} 完成 → ${OUTPUT}"
