#!/bin/bash
#SBATCH --job-name=jax_evalonce_{EXP_ID}
#SBATCH --output=logs/jax_evalonce_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_evalonce_{EXP_ID}_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#
# 對「已完成訓練的 ckpt」補跑一次 final eval，不重訓。
#
# 何時需要：訓練成功但 eval 失敗（train_exp.sbatch.tmpl 的 eval 段只發 WARN，
# 不讓 job 失敗，所以 slurm 會回報 COMPLETED 而 artifacts 缺 metrics.json），
# 或事後要換評估協定／補 --export-arrays / --export-fields。
#
# 環境變數：
#   ARTIFACTS_DIR       ckpt 所在（必填，須與訓練一致，否則讀不到／讀錯 ckpt）
#   ARCH                liquid（預設）或 vanilla；須與訓練一致
#   EVAL_TIME_STRIDE    DNS 取樣 stride（預設 2）
#   EVAL_FLAGS          額外 flag，例如間歇 sensor 的 --sensor-time-independent
#   OUTPUT_SUBDIR       輸出子目錄（預設 final_eval）
#
# 用法：
#   ARTIFACTS_DIR=artifacts/kolmogorov/gap70_b3 EVAL_FLAGS="--sensor-time-independent" \
#   TMPL=scripts/slurm/eval_once.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh gap70_b3 configs/exp_gap70_b3.toml

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
[ -d "$PILNJAX_DATA_ROOT/data" ] || { echo "[ERR] PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT 內無 data/ 目錄" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；head node 先 'uv sync --python 3.12'" >&2; exit 3; }
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false

STRIDE="${EVAL_TIME_STRIDE:-}"   # 無預設：給了是斷言，沒給由協定決定
PROTOCOL="${EVAL_PROTOCOL:?需指定 EVAL_PROTOCOL（follow_training / fixed_grid / sensor_time_independent）——無預設是刻意的}"
PROTOCOL_REASON="${PROTOCOL_REASON:-}"
PROTO_ARGS="--protocol ${PROTOCOL}"
[ -n "$STRIDE" ] && PROTO_ARGS="${PROTO_ARGS} --time-stride ${STRIDE}"
[ -n "$PROTOCOL_REASON" ] && PROTO_ARGS="${PROTO_ARGS} --protocol-reason ${PROTOCOL_REASON}"
ARCH="${ARCH:-liquid}"
SUBDIR="${OUTPUT_SUBDIR:-final_eval}"
: "${ARTIFACTS_DIR:?需設 ARTIFACTS_DIR（ckpt 位置，須與訓練一致）}"

echo "======================================================================"
echo "[JAX-EVALONCE-{EXP_ID}] $(date '+%F %T')  job=${SLURM_JOB_ID:-?}  node=${SLURMD_NODENAME:-?}"
echo "  config:        {CONFIG_PATH}"
echo "  ARCH:          ${ARCH}"
echo "  ARTIFACTS_DIR: ${ARTIFACTS_DIR}"
echo "  EVAL_TIME_STRIDE: ${STRIDE}   OUTPUT_SUBDIR: ${SUBDIR}"
echo "  EVAL_FLAGS:    ${EVAL_FLAGS:-<none>}"
echo "======================================================================"
nvidia-smi -L 2>/dev/null || echo "[WARN] nvidia-smi 不可用"
uv run python -c "import jax; print(f'JAX {jax.__version__}  devices={jax.devices()}')"

# cuDNN preflight（防 venv 漂移白跑）
uv run python -c "import jax, jax.numpy as jnp; from jax import lax; lax.conv_general_dilated(jnp.ones((1,8,8,1)), jnp.ones((3,3,1,1)), (1,1), 'SAME', dimension_numbers=('NHWC','HWIO','NHWC')).block_until_ready()" \
  || { echo '[ERR] cuDNN preflight 失敗 → head node 跑 scripts/slurm/setup_gpu_venv.sh 後重送' >&2; exit 5; }

# --optimizer 家族須與訓練一致（orbax restore 對 opt_state 嚴格檢查）
uv run python -u scripts/evaluate_exp245.py \
  ${PROTO_ARGS} \
  --config "{CONFIG_PATH}" \
  --ckpt latest \
  --arch "${ARCH}" \
  --optimizer schedule_free \
  --base_optimizer soap \
  --soap_precondition_frequency 2 \
  --artifacts_dir "${ARTIFACTS_DIR}" \
  --output-subdir "${SUBDIR}" \
  --no-plot \
  ${EVAL_FLAGS:-}

echo "[$(date '+%F %T')] EVALONCE-{EXP_ID} 完成 → ${ARTIFACTS_DIR}/${SUBDIR}/metrics.json"
