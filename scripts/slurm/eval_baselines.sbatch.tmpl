#!/bin/bash
#SBATCH --job-name=jax_eval_{EXP_ID}
#SBATCH --output=logs/jax_eval_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_eval_{EXP_ID}_%j.err
#SBATCH --time=04:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#
# What:
#   classical baseline（interp / gappy-POD）多-Re 重建對照表的 sbatch template。
#   由 scripts/slurm/submit_exp.sh（TMPL 覆寫）把 {EXP_ID}/{CONFIG_PATH} 替換後送 slurm。
#
# Why CPU-only（無 --gres=gpu:1）:
#   baselines 為 numpy/scipy（POD SVD + griddata），不需 GPU；設 JAX_PLATFORMS=cpu 讓
#   pi_lnn_jax.evaluate 的 jax import 走 CPU，把 GPU 留給訓練 job（good citizenship）。
#   ※ 若叢集政策要求 r740 job 必帶 GPU 才能排程，再加回 `#SBATCH --gres=gpu:1`。
#   ※ gappy-POD 的 SVD 吃 T×N² 記憶體；高 Re（N 大）務必用 MAX_GRID 控（預設 256）。
#
# Usage（在 lab-server head node；先 git pull + uv sync --python 3.12）:
#   TMPL=scripts/slurm/eval_baselines.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh baselines configs/eval_multi_re_train5_crp.toml
#   # 可調（env 覆寫）：
#   HELD_OUT=3000,8000,30000 MAX_GRID=256 BASELINES=interp_linear,gappy_pod \
#   TMPL=scripts/slurm/eval_baselines.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh baselines configs/eval_multi_re_train5_crp.toml
#   # 先看生成 sbatch 不送出：DRY=1 ... submit_exp.sh ...
#
# Output:
#   - slurm log：logs/jax_eval_{EXP_ID}_<jobid>.out / .err
#   - metrics JSON：artifacts/baseline_eval/{EXP_ID}_metrics.json（OUTPUT env 可覆寫）

set -euo pipefail

# ─── 1. repo root ──────────────────────────────────────────────────────
cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

# ─── 2. 環境 ───────────────────────────────────────────────────────────
export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
# data root：eval config 內 sensor/dns 為相對路徑，data.py 依 PILNJAX_ROOT → PILNJAX_DATA_ROOT 解析
export PILNJAX_ROOT="${PILNJAX_ROOT:-$(pwd)}"
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
{ [ -d "$PILNJAX_ROOT/data" ] || [ -d "$PILNJAX_DATA_ROOT/data" ]; } \
  || { echo "[ERR] 找不到 data/（PILNJAX_ROOT=$PILNJAX_ROOT 或 PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT）" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；先在 head node 跑 'uv sync --python 3.12'" >&2; exit 3; }
# baselines 不需 GPU；強制 CPU，避免 jax 嘗試抓 CUDA
export JAX_PLATFORMS=cpu

# ─── 3. 可調參數（env 覆寫；對齊 train template 的 ARTIFACTS_DIR 慣例） ──
PROTOCOL="${PROTOCOL:?需指定 PROTOCOL（follow_training / fixed_grid / sensor_time_independent）；\n\
  無預設是刻意的：預設會讓人吃到錯的那一個，而錯的不會 crash、只會在別的時間解析度上算數字}"
PROTOCOL_REASON="${PROTOCOL_REASON:-}"
SENSOR_TIME_STRIDE="${SENSOR_TIME_STRIDE:-}"
PROTO_ARGS="--protocol ${PROTOCOL}"
[ -n "$PROTOCOL_REASON" ] && PROTO_ARGS="${PROTO_ARGS} --protocol-reason ${PROTOCOL_REASON}"
[ -n "$SENSOR_TIME_STRIDE" ] && PROTO_ARGS="${PROTO_ARGS} --sensor-time-stride ${SENSOR_TIME_STRIDE}"
HELD_OUT="${HELD_OUT:-}"
BASELINES="${BASELINES:-interp_linear,gappy_pod}"
MAX_GRID="${MAX_GRID:-256}"
SENSOR_T="${SENSOR_T:-50}"
POD_MODES="${POD_MODES:-0}"
OUTPUT="${OUTPUT:-artifacts/baseline_eval/{EXP_ID}_metrics.json}"

HELD_ARG=""
[ -n "$HELD_OUT" ] && HELD_ARG="--held-out ${HELD_OUT}"

# ─── 4. 環境摘要 ───────────────────────────────────────────────────────
echo "======================================================================"
echo "[JAX-EVAL-{EXP_ID}] $(date '+%F %T')  slurm_job=${SLURM_JOB_ID}  node=${SLURMD_NODENAME:-?}"
echo "  repo:      $(pwd)"
echo "  config:    {CONFIG_PATH}"
echo "  baselines: ${BASELINES}   held-out: ${HELD_OUT:-<none>}   max-grid: ${MAX_GRID}"
echo "  output:    ${OUTPUT}"
echo "  protocol:  ${PROTOCOL}   reason: ${PROTOCOL_REASON:-<none>}"
echo "  JAX_PLATFORMS=${JAX_PLATFORMS}  cpus=${SLURM_CPUS_PER_TASK:-?}  mem=${SLURM_MEM_PER_NODE:-?}MB"
echo "======================================================================"
uv --version

# ─── 5. baseline eval ──────────────────────────────────────────────────
uv run python -u scripts/evaluate_baselines.py \
  --config "{CONFIG_PATH}" \
  --baselines "${BASELINES}" \
  --sensor-T "${SENSOR_T}" \
  --max-grid "${MAX_GRID}" \
  --pod-modes "${POD_MODES}" \
  --output "${OUTPUT}" \
  ${PROTO_ARGS} \
  ${HELD_ARG}

echo "[$(date '+%F %T')] JAX-EVAL-{EXP_ID} 完成 → ${OUTPUT}"
