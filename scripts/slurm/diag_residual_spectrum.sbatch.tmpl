#!/bin/bash
#SBATCH --job-name=jax_resspec_{EXP_ID}
#SBATCH --output=logs/jax_resspec_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_resspec_{EXP_ID}_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#
# PDE residual 頻譜診斷（階段 2）：模型的 R(k) vs 真值地板，同一套離散化。
#
# 為何要 GPU：全 frame 重建（T×256² 個 query 點）走的是與 final eval 相同的
# forward 路徑；且 GPU 寫的 ckpt 在 head node 的 CPU JAX 上 orbax 推不出 sharding。
#
# 成本參考（TD-28）：K=100 / B3 / 256² 的 full-T 重建約 19 min（T=101）。
# T=201 約兩倍。K>128 記得設 PILNN_EVAL_CHUNK_BUDGET=400000（見 TD-28）。
#
# 環境變數：
#   ARTIFACTS_DIR   ckpt 所在（必填，須與訓練一致）
#   ARCH            liquid / vanilla / pinn（必填；它是 sbatch env、不進 config，
#                   config 相同不代表同一個模型）
#   EVAL_PROTOCOL   follow_training / fixed_grid / sensor_time_independent（必填）
#   PROTOCOL_REASON fixed_grid 必填
#   EVAL_TIME_STRIDE 給了是斷言；不給由協定決定
#   MAX_FRAMES      只取前 N 個連續 frame（預設 0 = 全部）
#   TIME_ORDER      時間差分階數 2（預設）或 4
#   OUTPUT_SUBDIR   輸出子目錄（預設 residual_spectrum）
#
# 用法：
#   ARTIFACTS_DIR=artifacts/kolmogorov/main5_s42 ARCH=liquid \
#   EVAL_PROTOCOL=follow_training \
#   TMPL=scripts/slurm/diag_residual_spectrum.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh resspec_main5s42 configs/exp_main5_s42.toml

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
[ -d "$PILNJAX_DATA_ROOT/data" ] || { echo "[ERR] PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT 內無 data/ 目錄" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
export UV_NO_SYNC=1        # 見 TD-27：離線 node 上 uv run 的預設同步永遠不可能成功
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；head node 先 'uv sync --python 3.12'" >&2; exit 3; }
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false

STRIDE="${EVAL_TIME_STRIDE:-}"   # 無預設：給了是斷言，沒給由協定決定
PROTOCOL="${EVAL_PROTOCOL:?需指定 EVAL_PROTOCOL（follow_training / fixed_grid / sensor_time_independent）——無預設是刻意的}"
PROTOCOL_REASON="${PROTOCOL_REASON:-}"
PROTO_ARGS="--protocol ${PROTOCOL}"
[ -n "$STRIDE" ] && PROTO_ARGS="${PROTO_ARGS} --time-stride ${STRIDE}"
[ -n "$PROTOCOL_REASON" ] && PROTO_ARGS="${PROTO_ARGS} --protocol-reason ${PROTOCOL_REASON}"
: "${ARTIFACTS_DIR:?需設 ARTIFACTS_DIR（ckpt 位置，須與訓練一致）}"
: "${ARCH:?需設 ARCH（liquid / vanilla / pinn）——它不進 config，必須顯式宣告}"
SUBDIR="${OUTPUT_SUBDIR:-residual_spectrum}"
OUT="${ARTIFACTS_DIR}/${SUBDIR}/spectrum.json"

echo "======================================================================"
echo "[JAX-RESSPEC-{EXP_ID}] $(date '+%F %T')  job=${SLURM_JOB_ID:-?}  node=${SLURMD_NODENAME:-?}"
echo "  config:        {CONFIG_PATH}"
echo "  ARCH:          ${ARCH}"
echo "  ARTIFACTS_DIR: ${ARTIFACTS_DIR}"
echo "  PROTOCOL:      ${PROTOCOL}  stride=${STRIDE:-<by protocol>}"
echo "  MAX_FRAMES:    ${MAX_FRAMES:-0}  TIME_ORDER: ${TIME_ORDER:-2}"
echo "  out:           ${OUT}"
echo "======================================================================"
nvidia-smi -L 2>/dev/null || echo "[WARN] nvidia-smi 不可用"
uv run python -c "import jax; print(f'JAX {jax.__version__}  devices={jax.devices()}')"

# cuDNN preflight（防 venv 漂移白跑）
uv run python -c "import jax, jax.numpy as jnp; from jax import lax; lax.conv_general_dilated(jnp.ones((1,8,8,1)), jnp.ones((3,3,1,1)), (1,1), 'SAME', dimension_numbers=('NHWC','HWIO','NHWC')).block_until_ready()" \
  || { echo '[ERR] cuDNN preflight 失敗 → head node 跑 scripts/slurm/setup_gpu_venv.sh 後重送' >&2; exit 5; }

uv run python -u scripts/diag_residual_spectrum_model.py \
  ${PROTO_ARGS} \
  --config "{CONFIG_PATH}" \
  --ckpt latest \
  --arch "${ARCH}" \
  --artifacts_dir "${ARTIFACTS_DIR}" \
  --max-frames "${MAX_FRAMES:-0}" \
  --time-order "${TIME_ORDER:-2}" \
  --out "${OUT}"

echo "[$(date '+%F %T')] RESSPEC-{EXP_ID} 完成 → ${OUT}"
