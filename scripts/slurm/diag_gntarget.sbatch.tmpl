#!/bin/bash
#SBATCH --job-name=jax_gnt_{EXP_ID}
#SBATCH --output=logs/jax_gnt_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_gnt_{EXP_ID}_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#
# GradNorm 的未受約束目標 w_computed = G_data/G_i，兩條 ref path 各一次
# 回答的問題：K=100 主線的權重全部 seed 精確等於 floor 0.05（job 5633），
#   那 floor 底下還有多深？floor/目標 若 ~1 則 clamp 幾乎無作用；若 >>1 則
#   physics 權重整個是 clamp 撐起來的。不需要新的訓練 run——目標是當前參數的函數。
#   同時量 trunk_out（production 覆蓋值）與 temporal_encoder（_build_grad_norm_fn
#   的預設，其 docstring 稱 trunk_out 會讓 GradNorm 反向運作）的差距 = TD-2 的代價。
#
# 為什麼要 GPU：ckpt 是 GPU 寫的，orbax 在 head node 的 CPU JAX 上推不出 sharding。
#
# 環境變數：
#   CONFIGS   空白分隔的 config 路徑清單。給了就忽略 {CONFIG_PATH}。
#
# 用法：
#   CONFIGS="configs/exp_pv_les_s1.toml configs/exp_pv_les_s42.toml" \
#   TMPL=scripts/slurm/diag_gntarget.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh gnw configs/exp_pv_les_s42.toml

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
[ -d "$PILNJAX_DATA_ROOT/data" ] || { echo "[ERR] PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT 內無 data/ 目錄" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；head node 先 'uv sync --python 3.12'" >&2; exit 3; }
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false

LIST="${CONFIGS:-{CONFIG_PATH}}"
echo "======================================================================"
echo "[JAX-GNT-{EXP_ID}] $(date '+%F %T')  job=${SLURM_JOB_ID:-?}  node=${SLURMD_NODENAME:-?}"
echo "  configs: ${LIST}"
echo "======================================================================"
nvidia-smi -L 2>/dev/null || echo "[WARN] nvidia-smi 不可用"

FAILED=""
for cfg in ${LIST}; do
  echo ""; echo "──────── ${cfg} ────────"
  uv run python -u scripts/diag_gradnorm_target.py \
    --config "${cfg}" --resume latest \
    || { echo "[WARN] ${cfg} 失敗 (rc=$?)"; FAILED="${FAILED} ${cfg}"; }
done

echo ""; echo "[$(date '+%F %T')] GNT-{EXP_ID} 完成；失敗：${FAILED:-（無）}"
