#!/bin/bash
#SBATCH --job-name=jax_offgrid_{EXP_ID}
#SBATCH --output=logs/jax_offgrid_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_offgrid_{EXP_ID}_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#
# 在 sensor 時戳之間查詢，量 continuous-time 宣稱的代價
# 回答的問題：A4
#
# 為什麼要 GPU：診斷本身算力需求低，但 ckpt 是 GPU 寫的，restore_eval_params 走
# lenient restore（reference_state=None），head node 的 CPU-only JAX 上 orbax
# 推不出 sharding 會直接 ValueError。與 diag_trainable_fourier 同因。
#
# 環境變數：
#   ARTIFACTS_DIR   ckpt 所在（選填；不給則用 config 的 artifacts_dir）
#   ARCH            liquid（預設）；須與訓練一致
#
# 用法：
#   TMPL=scripts/slurm/diag_offgrid.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh main5s42 configs/exp_main5_s42.toml

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
[ -d "$PILNJAX_DATA_ROOT/data" ] || { echo "[ERR] PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT 內無 data/ 目錄" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；head node 先 'uv sync --python 3.12'" >&2; exit 3; }
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false

ARCH="${ARCH:-liquid}"
EXTRA=""
[ -n "${ARTIFACTS_DIR:-}" ] && EXTRA="--artifacts-dir ${ARTIFACTS_DIR}"

echo "======================================================================"
echo "[JAX-OFFGRID-{EXP_ID}] $(date '+%F %T')  job=${SLURM_JOB_ID:-?}  node=${SLURMD_NODENAME:-?}"
echo "  config:   {CONFIG_PATH}"
echo "  ARCH:     ${ARCH}"
echo "======================================================================"
nvidia-smi -L 2>/dev/null || echo "[WARN] nvidia-smi 不可用"
uv run python -c "import jax; print(f'JAX {jax.__version__}  devices={jax.devices()}')"

uv run python -u scripts/diag_offgrid_query.py \
  --config "{CONFIG_PATH}" \
  --ckpt latest \
  --arch "${ARCH}" \
  ${EXTRA}

echo "[$(date '+%F %T')] OFFGRID-{EXP_ID} 完成"
