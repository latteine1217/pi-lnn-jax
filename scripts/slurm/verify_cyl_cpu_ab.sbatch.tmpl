#!/bin/bash
#SBATCH --job-name=jax_cylab_{EXP_ID}
#SBATCH --output=logs/jax_cylab_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_cylab_{EXP_ID}_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#
# What: cylinder 重構前 vs 重構後的 CPU 位元對拍。段落順序不可調換：
#     (0) determinism control  (1)(2) 兩邊各錄四份  (2.5) 弱路徑門檻
#     (2.7) ledger 關閉組態    (3) 對拍
#
# Why 只在 CPU 判: wave 1 job 4729 已證 GPU 上同碼兩跑 params_digest 就不同。
#
# 編排在 scripts/slurm/_verify_common.sh，判定在 scripts/_common/ab_compare.py。
#     本檔只留**這一案專屬**的東西：資料 symlink、record()、fixture→config 對照。
#     判定不得寫回 heredoc——那裡的程式碼只在 job 內執行、本機測試永遠碰不到。
#
# 已知坑（wave 1/2 實測）:
#   - train_cylinder.py 沒有 --artifacts_dir；ledger 落點取自
#     tk.get("artifacts_dir","artifacts")，四份 config 都沒設該鍵 → 全寫到同一個檔。
#     **必須每跑完一份立刻搬走**——這正是本案 record() 不能與另一案共用的原因。
#   - cylinder 的 finalize 不落盤（只 print），故評估面只能比 stdout 的報表區塊。
#   - cylinder 用原始 np.load(相對CWD)，不走 _resolve_data_path → 資料要 symlink 進各 worktree。
#   - compute node r740 沒有 rg → 用 grep。
#
# Usage（lab-server head node，HEAD worktree）:
#   BASE_WT=$HOME/pi-lnn-jax-basecyl CYL_DATA_SRC=$HOME/pi-lnn-jax/data \
#   EXPECT_BASE=<verify/base-cyl-f2d63ff 的 sha> EXPECT_HEAD=<受測 commit 的 sha> \
#   TMPL=scripts/slurm/verify_cyl_cpu_ab.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh cylab configs/exp_cyl_cexp002_notm.toml

set -euo pipefail

HEAD_WT="${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax-cyl}"
BASE_WT="${BASE_WT:-$HOME/pi-lnn-jax-basecyl}"
CYL_DATA_SRC="${CYL_DATA_SRC:-$HOME/pi-lnn-jax/data}"
cd "$HEAD_WT"
# shellcheck source=scripts/slurm/_verify_common.sh
source scripts/slurm/_verify_common.sh

vc_require_expect_base
vc_common_env
vc_preflight "$HEAD_WT" "$BASE_WT"

# 本案專屬：資料以 symlink 掛進兩個 worktree（np.load 讀相對 CWD 路徑）
for wt in "$HEAD_WT" "$BASE_WT"; do
  mkdir -p "$wt/data"
  for f in cylinder_v1.npz controlled_v2.npz; do
    [ -e "$wt/data/$f" ] || ln -s "$CYL_DATA_SRC/$f" "$wt/data/$f"
  done
done

HEAD_SHA="$(git -C "$HEAD_WT" rev-parse --short HEAD)"
BASE_SHA="$(git -C "$BASE_WT" rev-parse --short HEAD)"

echo "======================================================================"
echo "[CYL-AB-{EXP_ID}] $(date '+%F %T')  job=${SLURM_JOB_ID}  node=${SLURMD_NODENAME:-?}"
echo "  HEAD: $HEAD_WT ($HEAD_SHA)  entry $(wc -l < "$HEAD_WT/train_cylinder.py") 行"
echo "  BASE: $BASE_WT ($BASE_SHA)  entry $(wc -l < "$BASE_WT/train_cylinder.py") 行"
echo "        （BASE 的行數是重構前 525 行 + ledger 埋點，不是重構前的規模）"
echo "  預期 BASE=$EXPECT_BASE  HEAD=${EXPECT_HEAD:-（未指定）}"
echo "======================================================================"

vc_cleanup "$HEAD_WT" "$BASE_WT" det_a det_b ab cyloff

CFG_c1=configs/exp_cyl_cexp002_notm.toml
CFG_c2=configs/exp_cyl_cexp002.toml
CFG_c3=configs/exp_controlled_cyl_v2.toml
# c4：與 c1 逐鍵相同，只把 gradnorm_freq/al_update_freq 調小（5 / 7），
#     讓 20 步內 GradNorm 觸發 4 次、AL 觸發 2 次。c1-c3 的頻率大於步數，
#     那條路徑的重構從未被任何對拍涵蓋（§8.3）。
CFG_c4=configs/_ledger_cyl_weighting.toml

# 在 $1 worktree 錄 $2(=c1..c4) 到 $1/artifacts/$3/$2
# stdout 要留著：cylinder 的 finalize 只 print 不落盤，評估面只能從它比。
record () {
  local wt="$1" tag="$2" out="$3"
  local cfgvar="CFG_$tag"; local cfg="${!cfgvar}"
  ( cd "$wt" \
    && rm -f artifacts/rng_ledger.json \
    && mkdir -p "artifacts/$out/$tag" \
    && PYTHONPATH=. uv run python -u train_cylinder.py --config "$cfg" \
         --steps 20 --seed 42 --allow-cpu > "artifacts/$out/$tag/stdout.txt" 2>&1 \
    && mv artifacts/rng_ledger.json "artifacts/$out/$tag/rng_ledger.json" )
}

# ─── (0) determinism control ────────────────────────────────────────────
echo ""; echo "── (0) CPU determinism control：同碼兩跑 c1 ──"
set +e
record "$HEAD_WT" c1 det_a; R0A=$?
record "$HEAD_WT" c1 det_b; R0B=$?
set -e
echo "[0] 兩跑 rc=${R0A}/${R0B}"
[ "$R0A" -eq 0 ] && [ "$R0B" -eq 0 ] || {
  echo "[0] determinism 錄製失敗（rc=${R0A}/${R0B}）——不往下跑" >&2; exit 2; }
set +e
vc_determinism "$HEAD_WT" artifacts/det_a/c1/rng_ledger.json artifacts/det_b/c1/rng_ledger.json
R0=$?; set -e
[ "$R0" != "0" ] && { echo "[0] rc=$R0，不往下跑"; exit 2; }
echo "[0] determinism rc=0"

# ─── (1)(2) 兩邊各錄四份 ─────────────────────────────────────────────────
echo ""; echo "── (1) BASE（重構前單體 + ledger 埋點）──"
set +e
RB=0
for t in c1 c2 c3 c4; do
  record "$BASE_WT" "$t" ab; rc=$?
  [ "$rc" -eq 0 ] || RB=1
  echo "   base/$t rc=${rc}"
done
echo "── (2) HEAD（重構後）──"
RH=0
for t in c1 c2 c3 c4; do
  record "$HEAD_WT" "$t" ab; rc=$?
  [ "$rc" -eq 0 ] || RH=1
  echo "   head/$t rc=${rc}"
done
set -e
echo "[1/2] base_rc=${RB} head_rc=${RH}"

# ─── (2.5) 弱路徑門檻 ────────────────────────────────────────────────────
echo ""; echo "── (2.5) 弱路徑門檻：replay 必須走 build_context、初始化 digest 必須真的比 ──"
set +e
vc_weak_path_gate "$HEAD_WT" cylinder tests/test_cylinder_replay.py
RS=$?; set -e
echo "[2.5] 弱路徑門檻 rc=${RS}"

# ─── (2.7) ledger 關閉組態（production 組態）─────────────────────────────
# 前面每一段都在 PILNN_RNG_LEDGER=1 下進行，而 production 是**關閉**的。
# 本案 finalize 不落盤，故標的是標準輸出的評估報表區塊。
echo ""; echo "── (2.7) ledger 關閉組態（production 組態）──"
recoff () {
  ( cd "$1" && mkdir -p "$2" \
    && env -u PILNN_RNG_LEDGER PYTHONPATH=. uv run python -u train_cylinder.py \
         --config "$CFG_c1" --steps 20 --seed 42 --allow-cpu > "$2/stdout.txt" 2>&1 )
}
set +e
recoff "$BASE_WT" artifacts/cyloff/off; ROB=$?
recoff "$HEAD_WT" artifacts/cyloff/off; ROH=$?
echo "[2.7] 兩邊 rc=${ROB}/${ROH}"
[ "$ROB" -eq 0 ] && [ "$ROH" -eq 0 ] || { echo "[2.7] 錄製失敗" >&2; RO=1; }
vc_ab_compare "$HEAD_WT" "$BASE_WT" off "" \
  --stdout-rel 'artifacts/cyloff/{name}/stdout.txt'
RO=$?; set -e
echo "[2.7] ledger-off 對拍 rc=${RO}"

# ─── (3) 對拍 ───────────────────────────────────────────────────────────
echo ""; echo "── (3) BASE vs HEAD：commit 斷言 + 逐步 + digest + 評估報表 ──"
EVIDENCE="$HEAD_WT/knowledge/superpowers/evidence/cyl_ab_${SLURM_JOB_ID:-local}.json"
set +e
vc_ab_compare "$HEAD_WT" "$BASE_WT" c1,c2,c3,c4 "$EVIDENCE" \
  --ledger-rel 'artifacts/ab/{name}/rng_ledger.json' \
  --stdout-rel 'artifacts/ab/{name}/stdout.txt'
R3=$?; set -e

echo ""
echo "======================================================================"
echo "[CYL-AB-{EXP_ID}] det=0  base_rc=${RB}  head_rc=${RH}  replay_strict=${RS}  ledger_off=${RO}  compare=${R3}"
echo "  全部為 0 → cylinder 重構前後在 CPU 上逐位元相同（wave 2 驗收層 A 通過）"
echo "  證據：$EVIDENCE（請隨結論一併提交，讓第三人可複驗）"
echo "======================================================================"
exit $(( RB | RH | RS | RO | R3 ))
