#!/bin/bash
#SBATCH --job-name=jax_podobs_{EXP_ID}
#SBATCH --output=logs/jax_podobs_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_podobs_{EXP_ID}_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#
# K 支感測器對 DNS POD 子空間的可觀測性：κ(Θ_r) 與 oracle gappy 重建下界
# 回答的問題：diag_dns_pod_rank 的「400 量測對 92 未知數仍 4.3× 超定」是計數論證，
#             Θ_r 病不病態沒量過。病態的話瓶頸在佈點而不在算子，結論完全不同。
#
# 為什麼**不要** GPU：純 numpy，不建模型、不 restore ckpt、不碰 JAX。
#
# 環境變數：
#   DNS_PATH       DNS .npy（選填；預設主線 Re=10000）
#   SENSOR_JSON    sensor set（選填；預設 K=200 LES-QR 主線佈點）
#   TIME_STRIDE    時間下採樣（選填，預設 1）——腳本端無預設，這裡明示傳入
#   NOISE          逗號分隔的相對雜訊水準（選填，預設 0.0,0.05,0.10 對齊 noise 實驗）
#   OUT_PATH       JSON 落點（選填）
#
# 用法：
#   TMPL=scripts/slurm/diag_pod_obs.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh podobs configs/exp_k200_snap_st2_s42.toml
#   （config 只用來滿足 submit_exp.sh 的介面，本診斷不讀它）

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
[ -d "$PILNJAX_DATA_ROOT/data" ] || { echo "[ERR] PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT 內無 data/ 目錄" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；head node 先 'uv sync --python 3.12'" >&2; exit 3; }

DNS_PATH="${DNS_PATH:-data/dns/kolmogorov_dns_fp64_etdrk4_Re10000_N256_T5_dt2p5e4_si100_ds4.npy}"
SENSOR_JSON="${SENSOR_JSON:-data/kolmogorov_sensors/re10000/sensors_qrpivot_K200_N256_t0-5_si100_les_n256_T50standalone.json}"
TIME_STRIDE="${TIME_STRIDE:-1}"
NOISE="${NOISE:-0.0,0.05,0.10}"
OUT_PATH="${OUT_PATH:-artifacts/diag/pod_observability_{EXP_ID}.json}"

echo "======================================================================"
echo "[JAX-PODOBS-{EXP_ID}] $(date '+%F %T')  job=${SLURM_JOB_ID:-?}  node=${SLURMD_NODENAME:-?}"
echo "  dns:      ${DNS_PATH}"
echo "  sensors:  ${SENSOR_JSON}"
echo "  stride:   ${TIME_STRIDE}   noise: ${NOISE}"
echo "  out:      ${OUT_PATH}"
echo "======================================================================"

uv run python -u scripts/diag_pod_observability.py \
  --dns "${DNS_PATH}" \
  --sensors "${SENSOR_JSON}" \
  --time-stride "${TIME_STRIDE}" \
  --noise "${NOISE}" \
  --out "${OUT_PATH}"

echo "[$(date '+%F %T')] PODOBS-{EXP_ID} 完成"
