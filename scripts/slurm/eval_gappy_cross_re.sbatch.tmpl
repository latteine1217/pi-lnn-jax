#!/bin/bash
#SBATCH --job-name=jax_gcr_{EXP_ID}
#SBATCH --output=logs/jax_gcr_{EXP_ID}_%j.out
#SBATCH --error=logs/jax_gcr_{EXP_ID}_%j.err
#SBATCH --time=04:00:00
#SBATCH --partition=r740
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#
# cross-Re gappy-POD（pooled train-Re basis）sbatch；CPU-only（同 eval_baselines）。
# 用 submit_exp.sh 的 TMPL 覆寫送出：
#   HELD_OUT=3000,8000,30000 GRID=64 \
#   TMPL=scripts/slurm/eval_gappy_cross_re.sbatch.tmpl \
#     scripts/slurm/submit_exp.sh gcr configs/eval_multi_re_train5_crp.toml
# 若叢集要求 r740 job 帶 GPU 才排程，再加 #SBATCH --gres=gpu:1。

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$HOME/pi-lnn-jax}"
export PYTHONUNBUFFERED=1
export PYTHONPATH="${PYTHONPATH:-}:."
export PILNJAX_ROOT="${PILNJAX_ROOT:-$(pwd)}"
export PILNJAX_DATA_ROOT="${PILNJAX_DATA_ROOT:-$HOME/pi-lnn-jax-main}"
{ [ -d "$PILNJAX_ROOT/data" ] || [ -d "$PILNJAX_DATA_ROOT/data" ]; } \
  || { echo "[ERR] 找不到 data/（PILNJAX_ROOT=$PILNJAX_ROOT 或 PILNJAX_DATA_ROOT=$PILNJAX_DATA_ROOT）" >&2; exit 4; }
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "[ERR] uv 不在 PATH" >&2; exit 2; }
export UV_OFFLINE=1
[ -x .venv/bin/python ] || { echo "[ERR] .venv 不存在；先在 head node 跑 'uv sync --python 3.12'" >&2; exit 3; }
export JAX_PLATFORMS=cpu

PROTOCOL="${PROTOCOL:?需指定 PROTOCOL（follow_training / fixed_grid / sensor_time_independent）——無預設是刻意的}"
PROTOCOL_REASON="${PROTOCOL_REASON:-}"
PROTO_ARGS="--protocol ${PROTOCOL}"
[ -n "$PROTOCOL_REASON" ] && PROTO_ARGS="${PROTO_ARGS} --protocol-reason ${PROTOCOL_REASON}"

HELD_OUT="${HELD_OUT:-}"
GRID="${GRID:-64}"
SENSOR_T="${SENSOR_T:-50}"
POD_MODES="${POD_MODES:-0}"
OUTPUT="${OUTPUT:-artifacts/baseline_eval/{EXP_ID}_gappy_cross_re.json}"
HELD_ARG=""
[ -n "$HELD_OUT" ] && HELD_ARG="--held-out ${HELD_OUT}"

echo "[JAX-GCR-{EXP_ID}] $(date '+%F %T') job=${SLURM_JOB_ID} node=${SLURMD_NODENAME:-?}  config={CONFIG_PATH} grid=${GRID} held=${HELD_OUT:-<none>}"
uv --version

uv run python -u scripts/eval_gappy_cross_re.py \
  ${PROTO_ARGS} \
  --config "{CONFIG_PATH}" \
  --grid "${GRID}" \
  --sensor-T "${SENSOR_T}" \
  --pod-modes "${POD_MODES}" \
  --output "${OUTPUT}" \
  ${HELD_ARG}

echo "[$(date '+%F %T')] JAX-GCR-{EXP_ID} 完成 → ${OUTPUT}"
